yubao.hxin.cc {
	encode zstd gzip

	log {
		output file /var/log/yubao-dailyplan/access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	@root path /
	redir @root /product/child/ 302

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	reverse_proxy 127.0.0.1:8787
}
